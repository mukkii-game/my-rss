{
  "name": "ファミ通.com",
  "url": "https://www.famitsu.com/category/new-article/page/1",
  "description": "公開新着一覧のタイトル・リンク（非公式RSS、RSSHubの代替）。2026-10-11: ファミ通の部品名が「ArticleList_list」から「…-module-scss-module__ハッシュ__…」に変わったため、ハッシュに頼らない部分一致に変更",
  "item_selector": "main [class*='PrimaryCard-module'] a[aria-label][href^='/article/'], main [class*='SecondaryCard-module'] a[aria-label][href^='/article/']",
  "title": {
    "selector": ":scope",
    "attribute": "aria-label"
  },
  "link": {
    "selector": ":scope",
    "attribute": "href"
  },
  "image_from_link": {
    "selector": "img",
    "attribute": "src"
  },
  "fallback": {
    "item_selector": "main [class*='cardTitle'] a[href^='/article/'], main [class*='SecondaryCard-module'][class*='__title'] a[href^='/article/']",
    "title": {
      "selector": ":scope"
    },
    "link": {
      "selector": ":scope",
      "attribute": "href"
    }
  },
  "url_pattern": "^https://www\\.famitsu\\.com/article/[0-9]+/[0-9]+$",
  "max_items": 100
}
